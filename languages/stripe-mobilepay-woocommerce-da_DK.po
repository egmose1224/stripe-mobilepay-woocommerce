#: includes/class-smpw-payments.php:933
#, php-format
msgid "The MobilePay amount could not be captured right now (%s). It will be tried again automatically in 5 minutes, and then after 30 minutes and 2 hours; if that doesn't work, the order is set to Failed."
msgstr "MobilePay-beløbet kunne ikke trækkes lige nu (%s). Der prøves igen automatisk om 5 minutter og derefter efter 30 minutter og 2 timer; lykkes det ikke, sættes ordren til Mislykket."

#. translators: %s: why the amount couldn't be captured
#: includes/class-smpw-payments.php:1009
#, php-format
msgid "The amount could not be captured via MobilePay: %s. The order has been set to Failed — contact the customer about payment."
msgstr "Beløbet kunne ikke trækkes via MobilePay: %s. Ordren er sat til Mislykket — kontakt kunden om betaling."

#. translators: 1: why the amount couldn't be captured, 2: PaymentIntent ID, 3: amount, 4: date and time the hold expires
#: includes/class-smpw-payments.php:1015
#, php-format
msgid "The amount could not be captured via MobilePay: %1$s. The MobilePay hold (%2$s, %3$s) is still active until %4$s: mark the order Completed again to capture the amount — now or later, before the hold expires. The order has been set to Failed."
msgstr "Beløbet kunne ikke trækkes via MobilePay: %1$s. MobilePay-reservationen (%2$s, %3$s) er stadig aktiv til %4$s: markér ordren Gennemført igen for at trække beløbet — nu eller senere, inden reservationen udløber. Ordren er sat til Mislykket."

#: includes/class-smpw-payments.php:1018
msgid "The MobilePay amount could not be captured"
msgstr "MobilePay-beløbet kunne ikke trækkes"

#. translators: 1: amount, 2: the error
#: includes/class-smpw-payments.php:1066
#, php-format
msgid "The order is cancelled, but the MobilePay amount (%1$s) could not be refunded automatically: %2$s. Refund it in WooCommerce or in Stripe."
msgstr "Ordren er annulleret, men MobilePay-beløbet (%1$s) kunne ikke refunderes automatisk: %2$s. Refundér i WooCommerce eller i Stripe."

#: includes/class-smpw-payments.php:1068 includes/class-smpw-payments.php:1399
msgid "A MobilePay refund failed"
msgstr "MobilePay-refundering mislykkedes"

#. translators: 1: WooCommerce refund ID, 2: that refund's amount, 3: the amount asked for
#: includes/class-smpw-payments.php:1108
#, php-format
msgid "Nothing has been refunded: the refund could not be recognized — the newest refund (#%1$d) is for %2$s, not %3$s. Two refunds at the same time? Check the order and try again."
msgstr "Intet er refunderet: refunderingen kunne ikke genkendes — den nyeste refundering (#%1$d) er på %2$s, ikke %3$s. To refunderinger på samme tid? Tjek ordren, og prøv igen."

#: includes/class-smpw-payments.php:1130
msgid "The amount must be greater than 0."
msgstr "Beløbet skal være større end 0."

#: includes/class-smpw-payments.php:1133
msgid "The order is being processed right now — please try again in a moment."
msgstr "Ordren behandles lige nu — prøv igen om et øjeblik."

#: includes/class-smpw-payments.php:1141
msgid "The order has no MobilePay payment to refund."
msgstr "Ordren har ingen MobilePay-betaling at refundere."

#. translators: 1: WooCommerce refund ID, 2: Stripe refund ID
#: includes/class-smpw-payments.php:1151
#, php-format
msgid "Nothing has been refunded: refund #%1$d has already been sent to Stripe (%2$s) — two refunds at the same time? Check the order and try again."
msgstr "Intet er refunderet: refunderingen #%1$d er allerede sendt til Stripe (%2$s) — to refunderinger på samme tid? Tjek ordren, og prøv igen."

#. translators: 1: amount, 2: PaymentIntent ID
#: includes/class-smpw-payments.php:1157
#, php-format
msgid "%1$s has been booked as refunded. Nothing was captured via MobilePay (the hold %2$s has been released), so nothing is sent back."
msgstr "%1$s er bogført som refunderet. Der er ikke trukket noget via MobilePay (reservationen %2$s er frigivet), så intet sendes tilbage."

#. translators: 1: amount, 2: PaymentIntent ID
#: includes/class-smpw-payments.php:1164
#, php-format
msgid "%1$s is not sent back via MobilePay: the refund had already been deducted when the amount was captured (%2$s)."
msgstr "%1$s sendes ikke tilbage via MobilePay: refunderingen var allerede trukket fra, da beløbet blev trukket (%2$s)."

#. translators: 1: PaymentIntent ID, 2: the error
#: includes/class-smpw-payments.php:1170
#, php-format
msgid "The MobilePay payment (%1$s) could not be checked with Stripe, so nothing has been refunded: %2$s"
msgstr "MobilePay-betalingen (%1$s) kunne ikke tjekkes hos Stripe, så intet er refunderet: %2$s"

#. translators: 1: PaymentIntent ID, 2: PaymentIntent status
#: includes/class-smpw-payments.php:1212
#, php-format
msgid "The MobilePay payment (%1$s) has the status \"%2$s\" in Stripe — there is nothing to refund."
msgstr "MobilePay-betalingen (%1$s) har status \"%2$s\" hos Stripe — der er intet at refundere."

#. translators: %s: amount
#: includes/class-smpw-payments.php:1217
#, php-format
msgid "At most %s can be refunded via MobilePay on this order."
msgstr "Der kan højst refunderes %s via MobilePay på denne ordre."

#. translators: 1: amount, 2: Stripe refund ID
#: includes/class-smpw-payments.php:1225
#, php-format
msgid "Stripe has already refunded %1$s (%2$s) in an earlier attempt, but that refund has not been booked here yet (that happens when Stripe reports it, or with \"Sync with Stripe\" in the MobilePay box). Do not refund again now — check the payment in the Stripe dashboard."
msgstr "Stripe har allerede refunderet %1$s (%2$s) i et tidligere forsøg, men den refundering er ikke bogført her endnu (det sker, når Stripe melder den, eller med \"Synkronisér med Stripe\" i MobilePay-boksen). Refundér ikke igen nu — tjek betalingen i Stripe-dashboardet."

#. translators: %s: Stripe's error message
#: includes/class-smpw-payments.php:1250
#, php-format
msgid "Stripe rejected the refund: %s"
msgstr "Stripe afviste refunderingen: %s"

#. translators: 1: Stripe refund ID, 2: refund status
#: includes/class-smpw-payments.php:1257
#, php-format
msgid "Stripe could not complete the refund (%1$s, status: %2$s)."
msgstr "Stripe kunne ikke gennemføre refunderingen (%1$s, status: %2$s)."

#. translators: 1: amount, 2: Stripe refund ID, 3: " — " and the refund's reason, or nothing
#: includes/class-smpw-payments.php:1270
#, php-format
msgid "%1$s has been refunded via MobilePay (%2$s)%3$s."
msgstr "%1$s er refunderet via MobilePay (%2$s)%3$s."

#. translators: 1: amount, 2: Stripe refund ID, 3: " — " and the refund's reason, or nothing, 4: refund status
#: includes/class-smpw-payments.php:1272
#, php-format
msgid "%1$s has been sent for refund via MobilePay (%2$s)%3$s. Stripe is still processing it (status: %4$s); if it fails, a note will appear here."
msgstr "%1$s er sendt til refundering via MobilePay (%2$s)%3$s. Stripe behandler den stadig (status: %4$s); mislykkes den, kommer der en besked her."

#. translators: 1: amount, 2: PaymentIntent ID, 3: PaymentIntent status
#: includes/class-smpw-payments.php:1328
#, php-format
msgid "%1$s has been booked as refunded. The MobilePay payment (%2$s) has no active hold (status: %3$s), so there is nothing to release or send back."
msgstr "%1$s er bogført som refunderet. MobilePay-betalingen (%2$s) har ingen aktiv reservation (status: %3$s), så der er intet at frigive eller sende tilbage."

#. translators: 1: amount refunded, 2: the most that will be captured
#: includes/class-smpw-payments.php:1337
#, php-format
msgid "%1$s will not be captured (refunded before shipping). When the order is marked Completed, at most %2$s will be captured; the rest of the hold will be released."
msgstr "%1$s trækkes ikke (refunderet før afsendelse). Ved Gennemført trækkes højst %2$s; resten af reservationen frigives."

#. translators: %s: PaymentIntent ID
#: includes/class-smpw-payments.php:1342
#, php-format
msgid "The MobilePay hold (%s) could not be released in Stripe, so the refund has not been made. Please try again shortly."
msgstr "MobilePay-reservationen (%s) kunne ikke frigives hos Stripe, så refunderingen er ikke gennemført. Prøv igen om lidt."

#. translators: 1: PaymentIntent ID, 2: amount
#: includes/class-smpw-payments.php:1347
#, php-format
msgid "The full amount was refunded before it was captured — the MobilePay hold (%1$s, %2$s) has been released."
msgstr "Hele beløbet er refunderet, før det blev trukket — MobilePay-reservationen (%1$s, %2$s) er frigivet."

#. translators: 1: Stripe refund ID, 2: amount
#: includes/class-smpw-payments.php:1394
#, php-format
msgid "The MobilePay refund %1$s (%2$s) has failed in Stripe — the money has not been sent back. Check the payment in the Stripe dashboard."
msgstr "MobilePay-refunderingen %1$s (%2$s) er mislykket hos Stripe — pengene er ikke sendt tilbage. Tjek betalingen i Stripe-dashboardet."

#. translators: 1: Stripe refund ID, 2: amount
#: includes/class-smpw-payments.php:1396
#, php-format
msgid "The MobilePay refund %1$s (%2$s) has been canceled in Stripe — the money has not been sent back. Check the payment in the Stripe dashboard."
msgstr "MobilePay-refunderingen %1$s (%2$s) er annulleret hos Stripe — pengene er ikke sendt tilbage. Tjek betalingen i Stripe-dashboardet."

#. translators: 1: Stripe refund ID, 2: amount, 3: what the order has left to refund
#: includes/class-smpw-payments.php:1415
#, php-format
msgid "A refund in Stripe (%1$s, %2$s) cannot be booked here: the order only has %3$s left to refund. Check the order and the payment in the Stripe dashboard."
msgstr "En refundering i Stripe (%1$s, %2$s) kan ikke bogføres her: ordren har kun %3$s tilbage at refundere. Tjek ordren og betalingen i Stripe-dashboardet."

#: includes/class-smpw-payments.php:1417 includes/class-smpw-payments.php:1441
msgid "A MobilePay refund could not be booked"
msgstr "MobilePay-refundering kunne ikke bogføres"

#. translators: %s: Stripe refund ID
#: includes/class-smpw-payments.php:1426
#, php-format
msgid "Refunded in Stripe (%s)"
msgstr "Refunderet i Stripe (%s)"

#. translators: 1: Stripe refund ID, 2: amount, 3: the error
#: includes/class-smpw-payments.php:1439
#, php-format
msgid "A refund in Stripe (%1$s, %2$s) could not be booked here right now: %3$s. It will be tried again automatically."
msgstr "En refundering i Stripe (%1$s, %2$s) kunne ikke bogføres her lige nu: %3$s. Der prøves igen automatisk."

#. translators: 1: amount, 2: Stripe refund ID
#: includes/class-smpw-payments.php:1450
#, php-format
msgid "%1$s has been refunded in Stripe (%2$s) and booked as a refund here."
msgstr "%1$s er refunderet i Stripe (%2$s) og bogført som refundering her."

#. translators: 1: amount, 2: Stripe refund ID
#: includes/class-smpw-payments.php:1452
#, php-format
msgid "%1$s has been refunded via MobilePay (%2$s), but the refund did not exist here (Stripe's answer got lost, or it was deleted) — now it has been booked."
msgstr "%1$s er refunderet via MobilePay (%2$s), men refunderingen fandtes ikke her (svaret fra Stripe gik tabt, eller den er slettet) — nu er den bogført."

#. translators: %s: Stripe dispute ID
#: includes/class-smpw-payments.php:1505
#, php-format
msgid "The dispute over the MobilePay payment (%s) has been decided: won — the money stays with the shop."
msgstr "Indsigelsen mod MobilePay-betalingen (%s) er afgjort: vundet — pengene bliver hos butikken."

#. translators: %s: Stripe dispute ID
#: includes/class-smpw-payments.php:1508
#, php-format
msgid "The dispute over the MobilePay payment (%s) has been decided: lost — the amount has been returned to the customer."
msgstr "Indsigelsen mod MobilePay-betalingen (%s) er afgjort: tabt — beløbet er ført tilbage til kunden."

#. translators: %s: Stripe dispute ID
#: includes/class-smpw-payments.php:1511
#, php-format
msgid "The dispute over the MobilePay payment (%s) has been decided: closed."
msgstr "Indsigelsen mod MobilePay-betalingen (%s) er afgjort: lukket."

#. translators: 1: Stripe dispute ID, 2: amount, 3: the reason Stripe gives
#: includes/class-smpw-payments.php:1514
#, php-format
msgid "The customer has disputed the MobilePay payment (%1$s, %2$s, reason: %3$s). Respond in the Stripe dashboard before the deadline."
msgstr "Kunden har gjort indsigelse mod MobilePay-betalingen (%1$s, %2$s, årsag: %3$s). Svar i Stripe-dashboardet inden fristen."

#: includes/class-smpw-payments.php:1518
msgid "A MobilePay payment has been disputed"
msgstr "Indsigelse mod en MobilePay-betaling"

#. translators: 1: PaymentIntent ID, 2: amount
#: includes/class-smpw-payments.php:1561
#, php-format
msgid "The customer paid with another payment method, but also approved MobilePay (%1$s). The MobilePay hold (%2$s) has been released."
msgstr "Kunden betalte med en anden betalingsmetode, men godkendte også MobilePay (%1$s). MobilePay-reservationen (%2$s) er frigivet."

#. translators: 1: PaymentIntent ID, 2: amount
#: includes/class-smpw-payments.php:1566
#, php-format
msgid "The customer paid with another payment method, but the MobilePay hold (%1$s, %2$s) could not be released automatically. Release it in the Stripe dashboard."
msgstr "Kunden betalte med en anden betalingsmetode, men MobilePay-reservationen (%1$s, %2$s) kunne ikke frigives automatisk. Frigiv den i Stripe-dashboardet."

#: includes/class-smpw-payments.php:1568
msgid "An extra MobilePay payment could not be released"
msgstr "Ekstra MobilePay-betaling kunne ikke frigives"

#. translators: 1: PaymentIntent ID, 2: amount
#: includes/class-smpw-payments.php:1577
#, php-format
msgid "The customer paid with another payment method, but the MobilePay amount (%1$s, %2$s) was captured too — it has been refunded."
msgstr "Kunden betalte med en anden betalingsmetode, men MobilePay-beløbet (%1$s, %2$s) blev også trukket — det er refunderet."

#: includes/class-smpw-payments.php:1585
msgid "An extra MobilePay payment was released"
msgstr "Ekstra MobilePay-betaling frigivet"

#: includes/class-smpw-return.php:15
msgid "The MobilePay payment was not completed. Please try again, or choose another payment method."
msgstr "MobilePay-betalingen blev ikke gennemført. Prøv igen, eller vælg en anden betalingsmetode."

#: includes/class-smpw-return.php:20
msgid "We are still waiting for an answer from MobilePay. If you have approved the payment, your order will go through by itself, and you will receive an order confirmation by e-mail."
msgstr "Vi mangler stadig svar fra MobilePay. Har du godkendt betalingen, går ordren igennem af sig selv, og du får en ordrebekræftelse på mail."

#. translators: %s: the shop's name
#: includes/class-smpw-return.php:156
#, php-format
msgid "Waiting for MobilePay – %s"
msgstr "Vi venter på MobilePay – %s"

#: includes/class-smpw-return.php:157
msgid "Waiting for an answer from MobilePay …"
msgstr "Vi venter på svar fra MobilePay …"

#: includes/class-smpw-return.php:157
msgid "This page refreshes by itself. Please don't close it — we'll send you on as soon as the payment is confirmed."
msgstr "Siden opdaterer sig selv. Luk den ikke — vi sender dig videre, så snart betalingen er bekræftet."

#: includes/class-smpw-return.php:157
msgid "Refresh now"
msgstr "Opdatér nu"

#. translators: %s: "test" or "live"
#: includes/class-smpw-stripe.php:73
#, php-format
msgid "Stripe is not connected in %s mode."
msgstr "Stripe er ikke forbundet i %s-tilstand."

#. translators: %d: HTTP status code
#: includes/class-smpw-stripe.php:132
#, php-format
msgid "Stripe returned HTTP %d"
msgstr "Stripe svarede %d"

#: includes/class-smpw-webhook.php:143
msgid "Stripe answered without a webhook ID or signing secret."
msgstr "Stripe svarede uden webhook-id eller hemmelighed."
